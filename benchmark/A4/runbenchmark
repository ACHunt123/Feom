# This script runs the benchmark for the DebyeSB model

echo "Starting benchmark for A4 model with Debye bath and spin boson..."
# # command to run the feom.py script
/home/ach221/software/phd/Feom/feom.py --L 20 --K 2 --ns 2 --beta 76.38347965440828 --hbar 1.0 --tmax 10.0 --dt 0.0001 --potname spinboson --Delta 0.9418180616196841 --eps 0.0 --bathname debyeCothpoles --bathmode AAA --eta 3.7672722464787363 --gam 0.056509083697181044 
